<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutRoom"
        style="@style/Widget.AutoClicker.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_room"
        app:helperText="@string/helper_room"
        app:helperTextEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textDirection="anyRtl" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonTestChannel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_test_channel" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkRestrictRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_restrict_room" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/helper_restrict_room"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchReturn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_return_before_send" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/helper_return_before_send"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchIdleScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_idle_screen" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchKeepScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_keep_screen" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/helper_keep_screen"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
