<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/rowAccessibility"
        layout="@layout/row_permission" />

    <include
        android:id="@+id/rowOverlay"
        layout="@layout/row_permission" />

    <include
        android:id="@+id/rowNotifications"
        layout="@layout/row_permission" />

    <include
        android:id="@+id/rowBattery"
        layout="@layout/row_permission" />

    <include
        android:id="@+id/rowNotificationAccess"
        layout="@layout/row_permission" />

    <include
        android:id="@+id/rowExactAlarm"
        layout="@layout/row_permission"
        android:visibility="gone" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/restricted_settings_hint"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGuide"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/button_guide" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCheck"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/button_check" />
</LinearLayout>
