    <string name="guide_title">Setup guide</string>
    <string name="guide_intro">Menu names differ between devices, so the names below may not match yours exactly.</string>
    <string name="guide_restricted_title">1. Allow restricted settings (Android 13 and later)</string>
    <string name="guide_restricted_body">Open the app info screen, tap the menu in the top corner, and choose the option to allow restricted settings. If the option is missing, try turning on the accessibility service first, then come back.</string>
    <string name="guide_open_app_info">Open app info</string>
    <string name="guide_open_settings">Open settings</string>
    <string name="guide_accessibility_title">2. Turn on the accessibility service</string>
    <string name="guide_accessibility_body">In the accessibility settings, find this app, often under installed or downloaded apps, and turn it on.</string>
    <string name="guide_overlay_title">3. Allow display over other apps</string>
    <string name="guide_overlay_body">Find this app in the list and allow it to appear on top. The floating timer needs this.</string>
    <string name="guide_battery_title">4. Exempt the app from battery limits</string>
    <string name="guide_battery_body">Choose to allow the app to run without battery restrictions, so Android does not stop it in the background.</string>
    <string name="guide_autostart_title">5. Auto start (some devices)</string>
    <string name="guide_autostart_body">Some manufacturers add their own auto start or background permission. Look for it in the app info screen or the device manager app, and allow this app.</string>
    <string name="guide_screen_unavailable">This device does not offer that screen. Look for it in Settings.</string>

